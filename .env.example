DATABASE_URL=postgresql+psycopg2://audit:audit@db:5432/audit
SECRET_KEY=change-me-in-production-use-openssl-rand
DATA_DIR=./data
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=480
LOG_LEVEL=INFO
ENVIRONMENT=development

# --- Azure Blob persistence (optional but strongly recommended in Codespaces) ---
# Without this, data/ and the Postgres DB are wiped whenever the Codespace
# container is rebuilt. With it, ./go automatically restores on startup.
# Find the connection string in Azure Portal → Storage account → Access keys.
# AZURE_BLOB_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=<acct>;AccountKey=<key>;EndpointSuffix=core.windows.net
# AZURE_BLOB_CONTAINER=techsource-audit-data

# --- Direct-from-blob email import (only used when files are larger than HTTP upload limits) ---
# For multi-GB OST/PST files: upload to the container above via Azure Storage
# Explorer or `azcopy copy`, then call /api/datasets/import-email-from-blob
# with the relative paths under the container — the app streams them in.
